<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:background="@color/background_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="12dp">

        <!-- Hero: the profile that Play will start -->
        <LinearLayout
            android:id="@+id/hero_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/hero_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:id="@+id/hero_art"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_hero_art"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="12dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_continue"
                    android:textColor="@color/secondary_text"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/hero_profile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/primary_text"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />
                <TextView
                    android:id="@+id/hero_version"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/secondary_text"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <Button
                android:id="@+id/edit_profile_button"
                style="@style/OutlineButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_edit" />
        </LinearLayout>

        <!-- Shortcuts: one tap to every main area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tile_new_profile"
                style="@style/ShortcutTile"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="6dp">
                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/tile_icon_background"
                    android:backgroundTint="@color/accent">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_plus"
                        android:tint="@color/accent_on"
                        android:importantForAccessibility="no" />
                </FrameLayout>
                <TextView
                    style="@style/ShortcutTitle"
                    android:text="@string/home_tile_new_profile" />
                <TextView
                    style="@style/ShortcutSubtitle"
                    android:text="@string/home_tile_new_profile_sub" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/tile_mods"
                style="@style/ShortcutTile"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp">
                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/tile_icon_background"
                    android:backgroundTint="@color/tile_mint">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_nav_mods"
                        android:tint="@color/accent_on"
                        android:importantForAccessibility="no" />
                </FrameLayout>
                <TextView
                    style="@style/ShortcutTitle"
                    android:text="@string/home_tile_mods" />
                <TextView
                    style="@style/ShortcutSubtitle"
                    android:text="@string/home_tile_mods_sub" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/custom_control_button"
                style="@style/ShortcutTile"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp">
                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/tile_icon_background"
                    android:backgroundTint="@color/tile_peach">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_nav_controls"
                        android:tint="@color/accent_on"
                        android:importantForAccessibility="no" />
                </FrameLayout>
                <TextView
                    style="@style/ShortcutTitle"
                    android:text="@string/home_tile_controls" />
                <TextView
                    style="@style/ShortcutSubtitle"
                    android:text="@string/home_tile_controls_sub" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/tile_settings"
                style="@style/ShortcutTile"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="0dp">
                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/tile_icon_background"
                    android:backgroundTint="@color/tile_neutral">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_nav_settings"
                        android:tint="@color/accent_on"
                        android:importantForAccessibility="no" />
                </FrameLayout>
                <TextView
                    style="@style/ShortcutTitle"
                    android:text="@string/home_tile_settings" />
                <TextView
                    style="@style/ShortcutSubtitle"
                    android:text="@string/home_tile_settings_sub" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="4dp"
            android:text="@string/home_more"
            android:textColor="@color/secondary_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:clipToPadding="false">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/news_button"
                    style="@style/LauncherMenuButton.Universal"
                    android:layout_width="wrap_content"
                    android:paddingStart="14dp"
    android:paddingEnd="14dp"
                    android:drawableStart="@drawable/ic_menu_news"
                    android:text="@string/mcl_tab_wiki" />
                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/discord_button"
                    style="@style/LauncherMenuButton.Universal"
                    android:layout_width="wrap_content"
                    android:paddingStart="14dp"
    android:paddingEnd="14dp"
                    android:drawableStart="@drawable/ic_discord"
                    android:text="@string/mcl_button_discord" />
                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/install_jar_button"
                    style="@style/LauncherMenuButton.Universal"
                    android:layout_width="wrap_content"
                    android:paddingStart="14dp"
    android:paddingEnd="14dp"
                    android:drawableStart="@drawable/ic_menu_install_jar"
                    android:text="@string/main_install_jar_file" />
                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/share_logs_button"
                    style="@style/LauncherMenuButton.Universal"
                    android:layout_width="wrap_content"
                    android:paddingStart="14dp"
    android:paddingEnd="14dp"
                    android:drawableStart="@android:drawable/ic_menu_share"
                    android:text="@string/main_share_logs" />
                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/open_files_button"
                    style="@style/LauncherMenuButton.Universal"
                    android:layout_width="wrap_content"
                    android:paddingStart="14dp"
    android:paddingEnd="14dp"
                    android:drawableStart="@drawable/ic_folder"
                    android:text="@string/mcl_button_open_directory" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</ScrollView>
